pipeline {
    agent any

    parameters{
        booleanParam(defaultValue:false, description: "Are you human?", name:"human")
        }
    stages {
        stage('Build') {
            steps {
                echo "${BUILD_NUMBER}"
                echo "Iam human :${params.human}"
                sh 'mvn -B -DskipTests clean package'
                sleep(50)
            }
        }
        stage('Test') {
            steps {
                sh 'mvn test'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }
        stage('Deliver') {
            steps {
                sh './jenkins/scripts/deliver.sh'
                sleep(25)
            }
        }
        stage('Complete') {
            steps {
                echo 'Job Complete!'
                sleep(50)
            }
        }
    }
}
